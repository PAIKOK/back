{
  "name": "email-scheduler",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/workers/email.worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker:start": "node dist/workers/email.worker.js"
  },
  "dependencies": {
    "bullmq": "^5.7.0",
    "dotenv": "^16.4.0",
    "express": "^4.19.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.9.2",
    "nodemailer": "^6.9.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.14",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}